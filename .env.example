# Move4Epilepsy API - Configuration d'exemple
# Copie ce fichier en .env et adapte les valeurs selon ton environnement

# ============ ENVIRONNEMENT ============
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ============ SÉCURITÉ (⚠️ CRITIQUE EN PRODUCTION) ============
# Génère une clé secrète forte avec: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# ============ BASE DE DONNÉES POSTGRESQL ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/move4epilepsy

# Base de test (utilisée par pytest, jamais par le déploiement principal)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/move4epilepsy_test

# Alternative pour Docker:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/move4epilepsy

# ============ CORS ============
# Frontend URLs (séparées par des virgules pour production)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ============ SÉCURITÉ HTTP ============
FORCE_HTTPS=False
SECURE_COOKIES=True

# ============ RATE LIMITING ============
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ============ HOSTS AUTORISÉS ============
ALLOWED_HOSTS=*

# Pour production:
# ALLOWED_HOSTS=api.move4epilepsy.com,www.api.move4epilepsy.com

# ============ JWT ============
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ============ CONFIGURATION DE DÉVELOPPEMENT ============
# Active la documentation Swagger en développement
# En production, il faut désactiver (DEBUG=False)
API_V1_STR=/api/v1

# ============ LOGGING ============
LOG_DIR=logs

# ============ NOTES IMPORTANTES ============
# 1. En PRODUCTION:
#    - DEBUG = False OBLIGATOIRE
#    - SECRET_KEY = clé forte générée (JAMAIS par défaut)
#    - FORCE_HTTPS = True
#    - DATABASE_URL = URL sécurisée en production
#    - ENVIRONMENT = production
#
# 2. Pour générer SECRET_KEY sécurisée:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 3. Ne pas commiter ce fichier .env en contrôle de version!
